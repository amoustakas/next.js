{
  "name": "@mannachef/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify:round-trip": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register.mjs ./scripts/verify-round-trip.ts",
    "verify:responses": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register.mjs ./scripts/verify-response-schemas.ts",
    "verify": "pnpm run verify:round-trip && pnpm run verify:responses"
  },
  "dependencies": {
    "@mannachef/validators": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
