// 6. GROWTH
// =============================================================================

enum RewardType {
  FIXED_CREDIT
  PERCENT_DISCOUNT
  FREE_MEAL
  FREE_DELIVERY
}

enum ReferralRedemptionStatus {
  PENDING
  QUALIFIED
  REWARDED
  EXPIRED
  REVOKED
}

enum RewardLedgerDirection {
  CREDIT
  DEBIT
}

enum RewardLedgerReason {
  REFERRAL_REWARD
  REFERRAL_SIGNUP_BONUS
  PROMOTIONAL_GRANT
  MANUAL_ADJUSTMENT
  INVOICE_REDEMPTION
  EXPIRATION
  REVERSAL
}

model ReferralCode {
  id      String @id @default(cuid())
  code    String @unique @db.VarChar(40)
  ownerId String

  label              String?    @db.VarChar(160)
  rewardType         RewardType @default(FIXED_CREDIT)
  /// Set when rewardType is FIXED_CREDIT / FREE_MEAL / FREE_DELIVERY.
  rewardValueCents   Int?
  /// Set when rewardType is PERCENT_DISCOUNT. Whole percent, 1–100.
  rewardValuePercent Int?
  currency           String     @default("CAD") @db.VarChar(3)

  /// Reward granted to the referred party, if different from the owner's reward.
  refereeRewardCents Int?

  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("ReferralCodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  redemptions ReferralRedemption[] @relation("ReferralRedemptionCode")

  @@index([ownerId, isActive])
  @@index([isActive, expiresAt])
}

model ReferralRedemption {
  id             String @id @default(cuid())
  referralCodeId String
  referredUserId String

  status        ReferralRedemptionStatus @default(PENDING)
  qualifiedAt   DateTime?
  rewardedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?                  @db.Text
  /// Denormalised snapshot of the reward actually paid out, in minor units.
  rewardCents   Int?
  currency      String                   @default("CAD") @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referralCode ReferralCode @relation("ReferralRedemptionCode", fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredUser User         @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  ledgerEntries RewardLedgerEntry[] @relation("RewardLedgerRedemption")

  @@unique([referralCodeId, referredUserId])
  @@index([referredUserId])
  @@index([status, createdAt])
}

model RewardBalance {
  id     String @id @default(cuid())
  userId String @unique

  balanceCents          Int    @default(0)
  lifetimeEarnedCents   Int    @default(0)
  lifetimeRedeemedCents Int    @default(0)
  currency              String @default("CAD") @db.VarChar(3)

  lastEarnedAt   DateTime?
  lastRedeemedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries RewardLedgerEntry[] @relation("RewardLedgerBalance")

  @@index([balanceCents])
}

/// Append-only audit trail. Rows are never updated or deleted by application
/// code; corrections are expressed as a compensating REVERSAL entry.
model RewardLedgerEntry {
  id        String  @id @default(cuid())
  userId    String
  balanceId String?

  direction         RewardLedgerDirection
  reason            RewardLedgerReason
  amountCents       Int
  balanceAfterCents Int
  currency          String                @default("CAD") @db.VarChar(3)

  referralRedemptionId String?
  invoiceId            String?
  createdById          String?
  note                 String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                @relation("RewardLedgerSubject", fields: [userId], references: [id], onDelete: Cascade)
  balance            RewardBalance?      @relation("RewardLedgerBalance", fields: [balanceId], references: [id], onDelete: SetNull)
  referralRedemption ReferralRedemption? @relation("RewardLedgerRedemption", fields: [referralRedemptionId], references: [id], onDelete: SetNull)
  invoice            Invoice?            @relation("RewardLedgerInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("RewardLedgerActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([balanceId])
  @@index([reason, createdAt])
  @@index([referralRedemptionId])
  @@index([invoiceId])
  @@index([createdById])
}

