  petsNote String? @db.VarChar(280)

  deliveryFrequency  DeliveryFrequency @default(WEEKLY)
  budgetPerMealCents Int?
  currency           String            @default("CAD") @db.VarChar(3)

  serviceAddressLine1 String? @db.VarChar(200)
  serviceAddressLine2 String? @db.VarChar(200)
  serviceCity         String? @db.VarChar(120)
  serviceRegion       String? @db.VarChar(120)
  servicePostalCode   String? @db.VarChar(20)
  serviceCountry      String? @db.VarChar(2)
  serviceAccessNotes  String? @db.Text

  preferredContactMethod ContactMethod @default(EMAIL)
  preferredCookDays      String[]
  notes                  String?       @db.Text

  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  dietaryPreferences ClientIntakeFormTag[] @relation("IntakeTagForm")

  @@index([submittedAt])
  @@index([deliveryFrequency])
