# mannachef/apps/web/.env.example
# Copy this file to .env.local and fill in real values. Never commit real secrets.

# PostgreSQL connection string used by Prisma (packages/db)
DATABASE_URL="postgresql://user:password@localhost:5432/mannachef?schema=public"

# Auth.js v5 secret used to sign/encrypt session tokens. Generate with `npx auth secret`.
AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Email magic-link provider (Resend). Both must be set for the provider to be
# registered at all — see apps/web/src/server/auth.ts. Leave blank to disable.
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="MannaChef <hello@mannachef.example>"

# Google OAuth. Both must be set for the provider to be registered at all.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "true" to enable Auth.js debug logging. Never enable in production —
# the debug channel prints token and callback detail.
AUTH_DEBUG="false"

# Stripe API keys (test mode keys during local development)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# UploadThing API token for media uploads
UPLOADTHING_TOKEN="ut_placeholder"

# Public base URL of the deployed app, used for absolute links/callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
