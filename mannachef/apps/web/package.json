{
  "name": "@mannachef/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/register.mjs --test \"src/**/*.test.ts\"",
    "verify:referral": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/stub-register.mjs ./scripts/verify-referral-privilege.ts",
    "verify:superadmin": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/race-register.mjs ./scripts/verify-superadmin-race.ts",
    "verify:intake-hijack": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/intake-register.mjs ./scripts/verify-intake-referral-hijack.ts",
    "verify:intake-cap": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/intake-register.mjs ./scripts/verify-intake-referral-cap.ts",
    "verify:intake-allergens": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/intake-register.mjs ./scripts/verify-intake-allergen-write.ts",
    "verify:intake": "pnpm run verify:intake-hijack && pnpm run verify:intake-cap && pnpm run verify:intake-allergens",
    "verify:preemption": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/intake-register.mjs ./scripts/verify-referral-preemption.ts",
    "verify:media": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/intake-register.mjs ./scripts/verify-media-upload.ts",
    "verify:proration": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/billing-register.mjs ./scripts/verify-subscription-proration.ts",
    "verify:redemption": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/billing-register.mjs ./scripts/verify-referral-redemption-parity.ts",
    "verify:billing": "pnpm run verify:proration && pnpm run verify:redemption",
    "verify:mcv043": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/billing-register.mjs ./scripts/verify-mcv043.ts",
    "verify:mcv051": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./scripts/billing-register.mjs ./scripts/verify-mcv051.ts",
    "verify": "pnpm run test && pnpm run verify:referral && pnpm run verify:intake && pnpm run verify:preemption && pnpm run verify:media && pnpm run verify:billing && pnpm run verify:mcv043 && pnpm run verify:mcv051",
    "db:generate": "turbo run db:generate --filter=@mannachef/db",
    "gen:action-index": "node scripts/gen-action-index.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mannachef/db": "workspace:*",
    "@mannachef/validators": "workspace:*",
    "@mannachef/api-contract": "workspace:*",
    "next-auth": "5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.7.4",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-devtools": "^5.62.0",
    "zustand": "^5.0.2",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^4.0.0",
    "stripe": "^17.4.0",
    "motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "date-fns": "^4.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.4",
    "sonner": "^1.7.1",
    "uploadthing": "^7.4.4",
    "@uploadthing/react": "^7.1.5",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-progress": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.49",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.2.0"
  }
}
