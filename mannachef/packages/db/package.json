{
  "name": "@mannachef/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "verify:drift": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/verify-migration-drift.ts",
    "verify:conflict-targets": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./scripts/verify-conflict-targets.ts",
    "verify": "pnpm run verify:drift && pnpm run verify:conflict-targets"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "devDependencies": {
    "prisma": "^6.2.0",
    "typescript": "^5.9.0"
  }
}
