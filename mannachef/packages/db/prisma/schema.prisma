enum OnboardingStage {
  INVITED
  ACCOUNT_CREATED
  INTAKE_SUBMITTED
  CONSULTATION_SCHEDULED
  CONSULTATION_COMPLETED
  PLAN_SELECTED
  PAYMENT_CONFIRMED
  FIRST_APPOINTMENT_BOOKED
  ACTIVATED
  ABANDONED
}

enum DeliveryFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ON_DEMAND
}

enum ConsultationOutcome {
  PENDING
  CONVERTED
  DECLINED_BY_CLIENT
  DECLINED_BY_CHEF
  NO_SHOW
  RESCHEDULED
  FOLLOW_UP_REQUIRED
}

/// Per-client stage machine. `currentStage` is the authoritative position;
/// `steps` records the completion timestamp of every stage passed through.
model OnboardingFlow {
  id              String @id @default(cuid())
  clientProfileId String @unique

  currentStage    OnboardingStage @default(INVITED)
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  abandonedAt     DateTime?
  abandonedReason String?         @db.Text
  lastAdvancedAt  DateTime?
  progressPercent Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  steps OnboardingStepCompletion[] @relation("OnboardingStepFlow")

  @@index([currentStage, lastAdvancedAt])
  @@index([completedAt])
}

model OnboardingStepCompletion {
  id               String @id @default(cuid())
  onboardingFlowId String

  stage       OnboardingStage
  completedAt DateTime        @default(now())
  note        String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingFlow OnboardingFlow @relation("OnboardingStepFlow", fields: [onboardingFlowId], references: [id], onDelete: Cascade)

  @@unique([onboardingFlowId, stage])
  @@index([stage, completedAt])
}

model ClientIntakeForm {
