/// Join between an intake form and DIETARY / ALLERGEN tags.
model ClientIntakeFormTag {
  id                 String @id @default(cuid())
  clientIntakeFormId String
  tagId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientIntakeForm ClientIntakeForm @relation("IntakeTagForm", fields: [clientIntakeFormId], references: [id], onDelete: Cascade)
  tag              Tag              @relation("IntakeTagTag", fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientIntakeFormId, tagId])
  @@index([tagId])
}

model ConsultationInterview {
  id              String  @id @default(cuid())
  clientProfileId String
  conductedById   String?
  staffProfileId  String?

  scheduledFor    DateTime
  durationMinutes Int      @default(30)
  location        String?  @db.VarChar(200)
  meetingUrl      String?  @db.Text

  startedAt   DateTime?
  completedAt DateTime?

  /// 0–100 fit score produced by the consultation rubric.
  compatibilityScore  Int?
  notes               String?             @db.Text
  chefSummary         String?             @db.Text
  outcome             ConsultationOutcome @default(PENDING)
  followUpAt          DateTime?
  convertedToClientAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation("ConsultationClient", fields: [clientProfileId], references: [id], onDelete: Cascade)
  conductedBy   User?         @relation("ConsultationInterviewer", fields: [conductedById], references: [id], onDelete: SetNull)
  staffProfile  StaffProfile? @relation("ConsultationStaff", fields: [staffProfileId], references: [id], onDelete: SetNull)

  @@index([clientProfileId, scheduledFor])
  @@index([outcome, scheduledFor])
  @@index([conductedById, scheduledFor])
  @@index([staffProfileId, scheduledFor])
}

// =============================================================================
// 8. CALENDAR
// =============================================================================

enum AvailabilityRuleKind {
  RECURRING_WEEKLY
  DATE_OVERRIDE
}

enum BookingSlotStatus {
  OPEN
  HELD
  BOOKED
  FULL
  CANCELLED
  EXPIRED
}

enum ServiceType {
  IN_HOME_DINNER
  MEAL_PREP
  PRIVATE_EVENT
  COOKING_CLASS
  TASTING
  CATERING
  CONSULTATION
  DELIVERY_DROP_OFF
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A chef's availability rule. `kind = RECURRING_WEEKLY` uses `dayOfWeek`
/// (0 = Sunday … 6 = Saturday) bounded by `effectiveFrom`/`effectiveUntil`.
/// `kind = DATE_OVERRIDE` uses `specificDate` and wins over recurring rules.
/// `isBlackout = true` subtracts the window instead of adding it.
model ChefAvailability {
  id             String @id @default(cuid())
  staffProfileId String

  kind AvailabilityRuleKind @default(RECURRING_WEEKLY)

  /// 0–6, Sunday-indexed. Null for DATE_OVERRIDE rules.
  dayOfWeek    Int?
  /// Null for RECURRING_WEEKLY rules.
  specificDate DateTime? @db.Date

  /// Minutes from local midnight. `startMinute` is 0–1439 — 0 is midnight at the
  /// start of the day, and 1440 is only ever an end boundary. `endMinute` is
  /// 1–1440 — 1440 is midnight at the end of the day, and a window cannot end at
  /// the start of one. `endMinute` must be strictly greater than `startMinute`.
  /// All three rules are enforced by CHECK constraints in `0000_init`.
  startMinute Int
  endMinute   Int
  timeZone    String @default("America/Toronto") @db.VarChar(64)

  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  isBlackout Boolean @default(false)
  reason     String? @db.VarChar(280)
  note       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffProfile StaffProfile @relation("AvailabilityStaff", fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@unique([staffProfileId, kind, dayOfWeek, specificDate, startMinute, endMinute])
  @@index([staffProfileId, kind])
  @@index([staffProfileId, dayOfWeek])
  @@index([staffProfileId, specificDate])
  @@index([effectiveFrom, effectiveUntil])
  @@index([isBlackout])
}

/// A concrete, bookable window materialised from availability rules.
model BookingSlot {
  id             String @id @default(cuid())
  staffProfileId String

  startsAt DateTime
  endsAt   DateTime

  capacity    Int               @default(1)
  bookedCount Int               @default(0)
  status      BookingSlotStatus @default(OPEN)
  serviceType ServiceType?

  priceCents Int?
  currency   String    @default("CAD") @db.VarChar(3)
  holdsUntil DateTime?
  note       String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffProfile StaffProfile @relation("BookingSlotStaff", fields: [staffProfileId], references: [id], onDelete: Cascade)

  appointments ChefAppointment[] @relation("AppointmentSlot")

  @@unique([staffProfileId, startsAt, endsAt])
  @@index([staffProfileId, startsAt])
  @@index([status, startsAt])
  @@index([serviceType, startsAt])
  @@index([startsAt, endsAt])
}

model ChefAppointment {
  id              String  @id @default(cuid())
  clientProfileId String
  staffProfileId  String
  bookingSlotId   String?

  serviceType ServiceType       @default(IN_HOME_DINNER)
  status      AppointmentStatus @default(REQUESTED)

  startsAt                  DateTime
  endsAt                    DateTime
  prepStartsAt              DateTime?
  travelBufferBeforeMinutes Int       @default(0)
  travelBufferAfterMinutes  Int       @default(0)

  guestCount Int @default(2)

  addressLine1 String? @db.VarChar(200)
  addressLine2 String? @db.VarChar(200)
  city         String? @db.VarChar(120)
  region       String? @db.VarChar(120)
  postalCode   String? @db.VarChar(20)
  country      String? @db.VarChar(2)
  accessNotes  String? @db.Text

  totalCents    Int    @default(0)
  depositCents  Int    @default(0)
  gratuityCents Int    @default(0)
  currency      String @default("CAD") @db.VarChar(3)

  clientNotes String? @db.Text
  chefNotes   String? @db.Text

  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text
  cancelledById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation("AppointmentClient", fields: [clientProfileId], references: [id], onDelete: Cascade)
  staffProfile  StaffProfile  @relation("AppointmentStaff", fields: [staffProfileId], references: [id], onDelete: Restrict)
  bookingSlot   BookingSlot?  @relation("AppointmentSlot", fields: [bookingSlotId], references: [id], onDelete: SetNull)
  cancelledBy   User?         @relation("AppointmentCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  menuItems AppointmentMenuItem[] @relation("AppointmentMenuItemAppointment")
  invoices  Invoice[]             @relation("InvoiceAppointment")
  reviews   Review[]              @relation("ReviewAppointmentSubject")

  @@index([clientProfileId, startsAt])
  @@index([staffProfileId, startsAt])
  @@index([status, startsAt])
  @@index([serviceType, status])
  @@index([bookingSlotId])
  @@index([cancelledById])
  @@index([startsAt, endsAt])
}

model AppointmentMenuItem {
  id            String @id @default(cuid())
  appointmentId String
  menuItemId    String

  quantity            Int     @default(1)
  courseOrder         Int     @default(0)
  notes               String? @db.Text
  /// Price snapshot at booking time, so later catalogue changes never rewrite history.
  priceCentsAtBooking Int?
  currency            String  @default("CAD") @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment ChefAppointment @relation("AppointmentMenuItemAppointment", fields: [appointmentId], references: [id], onDelete: Cascade)
  menuItem    MenuItem        @relation("AppointmentMenuItemItem", fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, menuItemId])
  @@index([menuItemId])
  @@index([appointmentId, courseOrder])
}

// =============================================================================
// 9. CRM
// =============================================================================

enum NoteVisibility {
  PRIVATE
  STAFF
  ADMIN_ONLY
  CLIENT_VISIBLE
}

enum InteractionChannel {
  EMAIL
  PHONE
  SMS
  IN_APP
  IN_PERSON
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
}

model ClientNote {
  id              String  @id @default(cuid())
  clientProfileId String
  authorId        String?

  body       String         @db.Text
  pinned     Boolean        @default(false)
  visibility NoteVisibility @default(STAFF)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation("ClientNoteSubject", fields: [clientProfileId], references: [id], onDelete: Cascade)
  author        User?         @relation("ClientNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clientProfileId, pinned, createdAt])
  @@index([clientProfileId, createdAt])
  @@index([authorId])
  @@index([visibility])
}

model InteractionLog {
  id              String  @id @default(cuid())
  clientProfileId String
  loggedById      String?

  channel   InteractionChannel
  direction InteractionDirection @default(OUTBOUND)

  subject         String?  @db.VarChar(280)
  body            String?  @db.Text
  occurredAt      DateTime @default(now())
  durationMinutes Int?
  /// Provider message id (Resend, Twilio, …) for deduplication.
  externalRef     String?  @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile ClientProfile @relation("InteractionSubject", fields: [clientProfileId], references: [id], onDelete: Cascade)
  loggedBy      User?         @relation("InteractionLogger", fields: [loggedById], references: [id], onDelete: SetNull)

  @@index([clientProfileId, occurredAt])
  @@index([channel, occurredAt])
  @@index([direction, occurredAt])
  @@index([loggedById])
  @@index([externalRef])
}
